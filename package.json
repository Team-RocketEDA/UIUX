{
  "name": "rocketeda-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:electron": "vite build --ssr electron/main.ts --outDir dist-electron",
    "desktop": "npm run build && npm run build:electron && electron .",
    "desktop:dev": "npm run build:electron && VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:server": "vite build --ssr server/serve.ts --outDir dist-server",
    "serve": "npm run build && npm run build:server && node dist-server/serve.js",
    "preview": "vite preview",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
